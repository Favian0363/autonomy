# Toolchain for building MuJoCo on Windows with Zig as cc/c++/rc (no MSVC).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(_zig_tool_dir "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_C_COMPILER_FRONTEND_VARIANT GNU CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER_FRONTEND_VARIANT GNU CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER "${_zig_tool_dir}/zig-cc.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${_zig_tool_dir}/zig-c++.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_RC_COMPILER "${_zig_tool_dir}/zig-rc.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_AR "${_zig_tool_dir}/zig-ar.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${_zig_tool_dir}/zig-ranlib.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER_AR "${_zig_tool_dir}/zig-ar.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER_RANLIB "${_zig_tool_dir}/zig-ranlib.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_AR "${_zig_tool_dir}/zig-ar.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_RANLIB "${_zig_tool_dir}/zig-ranlib.cmd" CACHE FILEPATH "" FORCE)
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
# MuJoCo's Windows wide-path warnings are treated as errors under zig cc.
string(APPEND CMAKE_C_FLAGS_INIT " -Wno-format")
string(APPEND CMAKE_CXX_FLAGS_INIT " -Wno-format")